# Copia este fichero a .env.local y rellena los valores.
# Ninguna clave real entra en git.
# Todas se leen y se validan una sola vez en src/lib/env.ts.
# Ninguna lleva el prefijo NEXT_PUBLIC_: nada de esto puede llegar al navegador.

# Sitio
SITE_URL=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin: lista de correos autorizados, separados por comas
ADMIN_ALLOWED_EMAILS=

# Google OAuth, para el Sign-In del admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive, cuenta de servicio en solo lectura
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Calendar, solo lectura, para sugerir cliente en la cola
GOOGLE_CALENDAR_ID=

# Sesiones de galería y hash de IP
GALLERY_SESSION_SECRET=
IP_HASH_SALT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Proveedor de facturación. Se elige al empezar la fase 5.
# Mientras tanto, BILLING_PROVIDER=fake usa el adaptador de pruebas.
BILLING_PROVIDER=fake
BILLING_API_KEY=
BILLING_API_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron de Vercel
CRON_SECRET=
